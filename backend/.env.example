# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5003

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/freelance_platform

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# ─── Frontend URL (CORS) ──────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173
OAUTH_REDIRECT_BASE_URL=http://localhost:5173

# ─── OAuth providers ──────────────────────────────────────────────────────────
OAUTH_GOOGLE_ENABLED=true
OAUTH_GITHUB_ENABLED=true
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ─── File uploads ─────────────────────────────────────────────────────────────
UPLOAD_PATH=./uploads

# ─── IMAP Email Listener (for automated RFP/PRD intake from email) ────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your_rfp_inbox@gmail.com
IMAP_PASSWORD=your_16_char_app_password
IMAP_POLL_INTERVAL_MS=30000

# ─── RFP Intake Webhook Secret (optional, adds auth to intake endpoint) ────────
# RFP_INTAKE_WEBHOOK_SECRET=your_secret_here
# ADMIN_RFP_INTAKE_EMAIL_TO=admin@example.com

# ─── AI Providers — Primary ───────────────────────────────────────────────────
# Gemini (Google) — Primary AI provider
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=alternate_google_api_key  # fallback key name

# ─── AI Providers — Fallback Chain ────────────────────────────────────────────
# The system automatically tries providers in order: Gemini → Groq → OpenRouter → HuggingFace → Cohere
# Add API keys for whichever fallback providers you want enabled.

# Groq (fast LLaMA inference) — Fallback #1
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (access to Claude, Mistral, etc.) — Fallback #2
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# HuggingFace Inference API — Fallback #3
# HUGGINGFACE_API_KEY=your_hf_api_key_here
# HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Cohere Command — Fallback #4
# COHERE_API_KEY=your_cohere_api_key_here
# COHERE_MODEL=command-r
